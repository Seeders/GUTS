[Unit]
Description=gutsengine.app: the GUTS site (homepage and projects)
After=network.target

[Service]
User=guts
WorkingDirectory=/srv/site
ExecStart=/usr/bin/node --max-old-space-size=512 server.js --prod
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
