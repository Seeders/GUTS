# Node.js dependencies
node_modules/
cache/

# --- Projects ------------------------------------------------------------
# GUTS ships ONLY the Editor. Every other directory under projects/ is a
# GUTS-compatible project with its OWN git repository, cloned in locally and
# never tracked here. The editor server reads them all the same at runtime.
# To add one:  cd projects && git clone <a-guts-project-repo>
/projects/*
!/projects/Editor/
projects/Editor/dist/

build/.temp/**/*
dist/**/*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency lock files (optional, include if you don’t want to track them)
# package-lock.json
# yarn.lock

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS-specific files
.DS_Store
Thumbs.db

package-lock.json

# Editor-specific files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.backup
.claude/

# Packed GUTS release artifacts (built with npm pack)
*.tgz
